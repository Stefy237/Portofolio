---
/**
 * Shell de démonstration. Les données (profil, projets…) sont sérialisées en JSON dans la page
 * au build ; le script les lit et interprète les commandes localement, dans le navigateur.
 */
import { site } from '../../config/site';
import { projets } from '../../data/projets';
import { certifications } from '../../data/certifications';
import { ready } from '../../lib/content';
import type { AppMeta } from '../../apps/registry';
import type { TerminalData } from '../../scripts/terminal/types';

interface Props {
  apps: AppMeta[];
}

const { apps } = Astro.props;

const data: TerminalData = {
  name: site.name,
  firstName: site.firstName,
  title: site.title,
  location: site.location,
  availability: site.availability,
  email: site.email,
  osName: site.osName,
  links: { github: site.links.github, linkedin: site.links.linkedin, malt: site.links.malt },
  cv: ready.cv ? site.documents.cv : null,
  projets: projets.map((p) => ({
    slug: p.slug,
    name: p.name,
    summary: p.summary,
    description: p.description,
    stack: p.stack,
    links: [
      p.prod ? { label: 'Production', url: p.prod } : null,
      p.demo ? { label: 'Démo', url: p.demo } : null,
      p.repo ? { label: 'Code', url: `https://github.com/${p.repo}` } : null,
    ].filter((l): l is { label: string; url: string } => l !== null),
  })),
  certifications: certifications.map((c) => ({ name: c.name, status: c.status, targetDate: c.targetDate })),
  apps: apps.filter((a) => a.id !== 'terminal').map((a) => ({ id: a.id, label: a.label })),
};

// Empêche toute fermeture prématurée de la balise <script> par le contenu.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="term" data-terminal>
  <div class="term__output" data-term-output role="log" aria-live="polite" aria-label="Sortie du terminal"></div>
  <form class="term__line" data-term-form>
    <label class="term__prompt" for="term-input" data-term-prompt>laura@laura-os:~$</label>
    <input
      id="term-input"
      class="term__input"
      data-term-input
      type="text"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="send"
      aria-describedby="term-help"
    />
  </form>
  <p id="term-help" class="visually-hidden">Tapez help pour la liste des commandes. Tab complète la saisie, flèches haut et bas pour l'historique.</p>
  <div class="term__chips" aria-label="Commandes rapides">
    <span class="term__chips-label">Essayez :</span>
    <button type="button" data-cmd="whoami">whoami</button>
    <button type="button" data-cmd="projets">projets</button>
    <button type="button" data-cmd="open parcours">open parcours</button>
    <button type="button" data-cmd="contact">contact</button>
    <button type="button" data-cmd="help">help</button>
  </div>
  <script type="application/json" data-terminal-data set:html={json} />
</div>

<script>
  import { mountTerminal } from '../../scripts/terminal/shell';
  document.querySelectorAll<HTMLElement>('[data-terminal]').forEach(mountTerminal);
</script>

<style>
  .term {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 220px;
    background: var(--term-bg);
    color: var(--term-text);
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.65;
  }
  .term__output {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 14px 16px 4px;
    white-space: pre-wrap;
    word-break: break-word;
    cursor: text;
  }
  .term__output :global(.term__l--muted) {
    color: var(--term-muted);
  }
  .term__output :global(.term__lead) {
    color: var(--term-prompt);
    white-space: pre;
  }
  .term__output :global(.term__l--accent) {
    color: var(--term-prompt);
  }
  .term__output :global(.term__l--error) {
    color: var(--term-error);
  }
  .term__output :global(.term__l--command) {
    color: var(--term-text);
    margin-top: 6px;
  }
  .term__line {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 2px 16px 10px;
  }
  .term__prompt {
    color: var(--term-prompt);
    white-space: nowrap;
  }
  .term__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 32px;
    padding: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--term-text);
    font: inherit;
    caret-color: var(--term-prompt);
  }
  .term__line:focus-within {
    box-shadow: inset 0 -1px 0 var(--term-prompt);
  }
  .term__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 8px 12px 10px;
    border-top: 1px solid #222a35;
  }
  .term__chips-label {
    font-size: 12px;
    color: var(--term-muted);
    margin-right: 4px;
  }
  .term__chips button {
    min-height: 32px;
    padding: 4px 10px;
    border: 1px solid #2f3a47;
    border-radius: 7px;
    background: #161b22;
    color: var(--term-text);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
  }
  .term__chips button:hover {
    border-color: var(--term-prompt);
  }
  .term :focus-visible {
    outline-color: var(--term-prompt);
  }
</style>
