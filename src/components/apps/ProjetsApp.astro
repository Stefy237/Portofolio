---
/**
 * Projets, organisés comme un profil GitHub : colonne de profil à gauche,
 * dépôts épinglés et graphe de contributions à droite.
 * Les données GitHub (langage, étoiles, contributions) sont lues au build.
 */
import { site, shortUrl } from '../../config/site';
import { projets } from '../../data/projets';
import { getContributions, getRepo } from '../../lib/github';
import ContributionGraph from '../embeds/ContributionGraph.astro';
import Avatar from '../ui/Avatar.astro';
import Icon from '../ui/Icon.astro';
import Todo from '../ui/Todo.astro';

const contributions = await getContributions(site.githubUser);
const infos = await Promise.all(projets.map((p) => (p.repo ? getRepo(p.repo) : Promise.resolve(null))));
const monthYear = new Intl.DateTimeFormat('fr-FR', { month: 'short', year: 'numeric' });

/** Classe CSS de la pastille de langage (couleurs dans platforms.css). */
const langClass = (lang: string | null) =>
  lang ? `lang-${lang.toLowerCase().replace(/\+/g, 'p').replace(/#/g, 'sharp').replace(/[^a-z0-9]/g, '')}` : '';

const items = projets.map((p, i) => {
  const info = infos[i] ?? null;
  return { ...p, info, lang: info?.language ?? p.language, url: p.repo ? (info?.url ?? `https://github.com/${p.repo}`) : null };
});
---

<div class="gh">
  <aside class="gh__side" aria-label="Profil GitHub">
    <Avatar size={220} class="gh__avatar" />
    <h3 class="gh__name">{site.name}</h3>
    <p class="gh__login">{site.githubUser}</p>
    <p class="gh__bio">{site.title}</p>
    <a class="gh__follow" href={site.links.github} rel="me noopener">Voir sur GitHub <Icon name="external" size={13} /></a>
    <ul class="gh__facts">
      <li><Icon name="map" size={16} /> {site.location}</li>
      <li><Icon name="briefcase" size={16} /> {site.availability}</li>
      <li><Icon name="external" size={16} /> <a href={site.links.github} rel="me noopener">{shortUrl(site.links.github)}</a></li>
    </ul>
  </aside>

  <div class="gh__main">
    <h3 class="gh__label">Dépôts épinglés</h3>
    <ul class="gh__pinned">
      {
        items.map((p) => (
          <li class="repo">
            <div class="repo__head">
              <Icon name="folder" size={16} class="repo__icon" />
              {p.url ? (
                <a class="repo__name" href={p.url} rel="noopener">{p.repo ? p.repo.split('/')[1] : p.name}</a>
              ) : (
                <span class="repo__name">{p.name}</span>
              )}
              <span class="repo__vis">{p.repo ? 'Public' : p.prod ? 'En production' : 'Projet'}</span>
            </div>
            <p class="repo__desc">{p.featured ? p.description : p.summary}</p>
            {p.stack.length > 0 ? <p class="repo__topics">{p.stack.slice(0, 5).map((s) => <span>{s}</span>)}</p> : <Todo label={`Stack de ${p.name}`} />}
            <p class="repo__meta">
              {p.lang && (
                <span class="repo__lang">
                  <span class={`repo__dot ${langClass(p.lang)}`} aria-hidden="true" />
                  {p.lang}
                </span>
              )}
              {p.info && <span>★ {p.info.stars}</span>}
              {p.info && <span>Mis à jour en {monthYear.format(new Date(p.info.pushedAt))}</span>}
              {p.prod && <a href={p.prod} rel="noopener">Site <Icon name="external" size={12} /></a>}
              {p.demo && <a href={p.demo} rel="noopener">Démo <Icon name="external" size={12} /></a>}
            </p>
            {!p.repo && !p.prod && !p.demo && <Todo label="Lien vers le dépôt, la démo ou la prod" />}
          </li>
        ))
      }
    </ul>

    {
      (contributions || import.meta.env.DEV) && (
        <section class="gh__contrib" aria-labelledby="gh-contrib">
          <h3 class="gh__label" id="gh-contrib">
            {contributions ? `${contributions.total} contributions au cours de la dernière année` : 'Contributions'}
          </h3>
          <div class="gh__contrib-box">
            <ContributionGraph data={contributions} />
          </div>
        </section>
      )
    }
  </div>
</div>
