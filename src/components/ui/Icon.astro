---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  /** Texte alternatif. Sans label, l'icône est décorative (masquée aux lecteurs d'écran). */
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icons[name]}
/>
