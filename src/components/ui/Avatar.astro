---
/**
 * Photo de profil, ou initiales si la photo n'est pas encore déposée dans public/.
 */
import { site } from '../../config/site';
import { ready } from '../../lib/content';

interface Props {
  size: number;
  class?: string;
}

const { size, class: className } = Astro.props;
const initials = site.name
  .split(' ')
  .slice(0, 2)
  .map((p) => p[0])
  .join('');
---

{
  ready.photo ? (
    <img class:list={['avatar-img', className]} src={site.photo} alt={`Portrait de ${site.firstName}`} width={size} height={size} />
  ) : (
    <span class:list={['avatar-img avatar-img--initials', className]} aria-hidden="true">
      {initials}
    </span>
  )
}
